# Copie para .env e ajuste. O arquivo .env não é versionado.

# Competência dos dados da Receita Federal, no formato AAAA-MM.
# Obrigatória: não existe padrão defensável, depende do que a RFB publicou.
COMPETENCIA=2026-06

# UF do estabelecimento MATRIZ usada no recorte.
UF_ALVO=SP

# Raiz onde os dados baixados e processados são gravados.
DATA_DIR=data

# Se o nome de pessoa física entra nos artefatos do grafo.
# O artefato publicado é construído com false. Use true apenas em execução local
# sobre os dados originais: nome que entra no artefato é nome publicado, e a API
# filtrando depois não desfaz isso.
EXPOR_PF=false
